<Window x:Class="TermLens.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="术语镜 · TermLens" Icon="app.ico" Style="{StaticResource {x:Type Window}}" Width="560" Height="700" MinWidth="480" MinHeight="540" WindowStartupLocation="CenterScreen">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Image Source="{StaticResource BrandMark}" Width="30" Height="30" Margin="0,0,10,0"/>
    <TextBlock Text="术语镜" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Text="TERMLENS" FontSize="10" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
   </StackPanel>
   <Button x:Name="PauseButton" Grid.Column="1" Content="● 划词已开启" Click="Pause_Click" Style="{StaticResource Quiet}" FontSize="12" VerticalAlignment="Center" Margin="0"/>
  </Grid>
  <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabControl.Resources>
    <Style TargetType="TabItem">
     <Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,0,12,0"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <Border x:Name="TabSurface" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
       <ContentPresenter x:Name="TabHeader" ContentSource="Header" TextElement.Foreground="{StaticResource Muted}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{StaticResource Ink}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{StaticResource Soft}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
    </Style>
   </TabControl.Resources>
   <TabItem Header="查术语">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,22,0,12">
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="20">
       <StackPanel>
        <Border BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0" Padding="12,0,0,0" Margin="0,0,0,9"><TextBlock Text="查清一个概念。" FontSize="27" FontWeight="SemiBold"/></Border>
        <TextBlock Text="TERM LOOKUP" FontSize="10" Foreground="{StaticResource Muted}" Margin="15,0,0,22"/>
        <TextBlock Text="输入中英文术语或句子" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,9"/>
        <TextBox x:Name="TermInput" AutomationProperties.AutomationId="TermInput" MaxLength="2000" FontSize="18" MinHeight="48" KeyDown="Term_KeyDown" ToolTip="输入中英文术语或句子，按 Enter 查询"/>
        <WrapPanel Margin="0,8,0,12">
         <TextBlock Text="试试" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
         <Button Content="随机森林" Style="{StaticResource Quiet}" Padding="5,6" Margin="0,0,3,0" FontSize="12" Click="Example_Click"/>
         <Button Content="梯度下降" Style="{StaticResource Quiet}" Padding="5,6" Margin="0,0,3,0" FontSize="12" Click="Example_Click"/>
         <Button Content="Overfitting" Style="{StaticResource Quiet}" Padding="5,6" Margin="0" FontSize="12" Click="Example_Click"/>
        </WrapPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Expander VerticalAlignment="Top" Header="补充原句（可选）" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,14,0">
         <TextBox x:Name="ContextInput" MaxLength="3000" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,10,0,0" ToolTip="仅发送你主动填写的上下文"/>
        </Expander>
        <Button Grid.Column="1" VerticalAlignment="Top" Content="查解释  →" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0" Click="Query_Click" AutomationProperties.AutomationId="QueryButton" MinWidth="112"/>
        </Grid>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,14,0,0">
         <TextBlock Text="选中文字，点击旁边的选词框图标即可查询。" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="21"/>
        </Border>
       </StackPanel>
      </Border>
      <TextBlock Text="也可复制文字后按 Ctrl + Alt + D 查询。" Foreground="{StaticResource Muted}" FontSize="12" Margin="3,16,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="连接与设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,18,0,12">
      <TextBlock Text="连接你自己的 AI" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="支持 OpenAI 兼容的 Chat Completions 接口，费用由所选服务商收取。" Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
      <Border Background="White" CornerRadius="3" Padding="20" BorderBrush="{StaticResource Line}" BorderThickness="1">
       <StackPanel>
        <TextBlock Text="服务地址" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="UrlInput" AutomationProperties.AutomationId="UrlInput"/>
        <TextBlock Text="例如 https://服务地址/v1；支持完整接口地址。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,12"/>
        <TextBlock Text="API Key" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <PasswordBox x:Name="KeyInput" AutomationProperties.AutomationId="KeyInput"/>
        <TextBlock Text="使用 Windows 加密后保存在本机，不写入日志。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,12"/>
        <TextBlock Text="模型名称" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="ModelInput" AutomationProperties.AutomationId="ModelInput"/>
        <TextBlock Text="填写服务商给出的准确名称。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,14"/>
        <StackPanel Orientation="Horizontal">
         <Button Content="保存配置" Style="{StaticResource Primary}" Click="Save_Click"/>
         <Button x:Name="TestButton" Content="测试连接" Click="Test_Click"/>
        </StackPanel>
        <TextBlock x:Name="SettingsStatus" Margin="0,14,0,0" Foreground="{StaticResource Accent}" AutomationProperties.AutomationId="SettingsStatus"/>
       </StackPanel>
      </Border>
      <TextBlock Text="点击查询后，才会向此服务发送所选词语。不会自动发送整页、文件或剪贴板内容。测试连接会发送示例词「随机森林」，可能产生少量费用。" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,16,0,0" LineHeight="22"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="查询历史">
    <Grid Margin="0,18,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="回看查过的概念。" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="最近 100 条，仅保存在本机。点击查看已有解释；卡片里的“重新查询”会再次调用 AI。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16"/>
     </StackPanel>
     <TextBox x:Name="HistoryFilter" Grid.Row="1" TextChanged="HistoryFilter_Changed" ToolTip="按词句或上下文筛选历史" AutomationProperties.AutomationId="HistoryFilter"/>
     <DockPanel Grid.Row="2" Margin="0,8,0,10">
      <Button x:Name="ClearHistoryButton" Content="清空历史" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Padding="8,5" Margin="0" Click="ClearHistory_Click"/>
      <TextBlock x:Name="HistoryCount" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
     </DockPanel>
     <Grid Grid.Row="3">
      <ListBox x:Name="HistoryList" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate>
        <Button Tag="{Binding}" Click="HistoryOpen_Click" HorizontalContentAlignment="Stretch" Background="White" Foreground="{StaticResource Ink}" BorderThickness="1" Padding="12,10" Margin="0">
         <StackPanel>
          <TextBlock Text="{Binding Preview}" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Caption}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
         </StackPanel>
        </Button>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="HistoryEmpty" Text="还没有查询历史。完成一次查询后会自动保存。" Foreground="{StaticResource Muted}" FontSize="12" Margin="18" VerticalAlignment="Top" IsHitTestVisible="False"/>
     </Grid>
     <TextBlock x:Name="HistoryStatus" Grid.Row="4" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,10,0,0"/>
    </Grid>
   </TabItem>
  </TabControl>
  <StackPanel Grid.Row="2" Margin="0,14,0,0">
   <TextBlock x:Name="Status" Text="就绪 · 点击查询时才联网" Foreground="{StaticResource Muted}" FontSize="11"/>
   <TextBlock Text="关闭后驻留托盘 · 右键托盘可退出" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/>
  </StackPanel>
 </Grid>
</Window>
