<Window x:Class="TermLens.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="术语镜 · TermLens" Icon="app.ico" Style="{StaticResource {x:Type Window}}" Width="560" Height="700" MinWidth="480" MinHeight="540" WindowStartupLocation="CenterScreen">
 <Grid x:Name="WindowRoot" Margin="24,20,24,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Image Source="{StaticResource BrandMark}" Width="42" Height="42" Margin="-4,0,8,0"/>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="术语镜" FontSize="21" FontWeight="SemiBold"/>
     <TextBlock Text="让每一个概念更清晰" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
    </StackPanel>
   </StackPanel>
   <Button x:Name="PauseButton" Grid.Column="1" Content="● 划词已开启" Click="Pause_Click" FontSize="11" Padding="10,7" VerticalAlignment="Center" Margin="0"/>
  </Grid>
  <Grid x:Name="Root" Grid.Row="1" SizeChanged="LayoutDensity_Changed">
  <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
   <TabControl.Template><ControlTemplate TargetType="TabControl">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="#E8EBF0" BorderBrush="#E0E4EB" BorderThickness="1" CornerRadius="12" Padding="4">
      <UniformGrid Rows="1" IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
     </Border>
     <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
    </Grid>
   </ControlTemplate></TabControl.Template>
   <TabControl.Resources>
    <Style TargetType="TabItem">
     <Setter Property="Padding" Value="10,8"/>
     <Setter Property="FontSize" Value="12"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter x:Name="TabHeader" ContentSource="Header" HorizontalAlignment="Center" TextElement.Foreground="{StaticResource Muted}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="White"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="#D8DDE5"/><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{StaticResource Ink}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
    </Style>
   </TabControl.Resources>
   <TabItem Header="查询">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="QueryContent" Margin="0,20,0,8">
      <Border x:Name="QuerySheet" Style="{StaticResource Sheet}" Padding="22,24">
       <StackPanel>
        <TextBlock x:Name="HeroHeading" Text="查懂一个概念，&#10;继续你的探索。" FontSize="27" LineHeight="37" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock x:Name="HeroSubtitle" Text="划选后点图标，或在这里输入。" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,24"/>
        <TextBlock Text="术语或句子" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
        <TextBox x:Name="TermInput" AutomationProperties.AutomationId="TermInput" MaxLength="2000" FontSize="17" MinHeight="50" KeyDown="Term_KeyDown" ToolTip="输入中英文术语或句子，按 Enter 查询"/>
        <WrapPanel x:Name="ExamplesPanel" Margin="0,12,0,20">
         <Button Content="随机森林" Padding="9,5" Margin="0,0,6,4" FontSize="11" Click="Example_Click"/>
         <Button Content="梯度下降" Padding="9,5" Margin="0,0,6,4" FontSize="11" Click="Example_Click"/>
         <Button Content="Overfitting" Padding="9,5" Margin="0,0,0,4" FontSize="11" Click="Example_Click"/>
        </WrapPanel>
        <Expander Header="添加上下文" Foreground="{StaticResource Muted}" FontSize="12">
         <TextBox x:Name="ContextInput" MaxLength="3000" AcceptsReturn="True" Height="82" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,12,0,0" ToolTip="仅发送你主动填写的上下文"/>
        </Expander>
       </StackPanel>
      </Border>
      <Border x:Name="ReadingTip" CornerRadius="12" Background="#EDF0F5" Padding="14,12" Margin="0,14,0,0">
       <StackPanel>
        <TextBlock Text="阅读时，随选随查" FontSize="12" FontWeight="Medium" Margin="0,0,0,5"/>
        <TextBlock Text="选中文字后点击旁边的图标；也可复制文字，按 Ctrl + Alt + D。" Foreground="{StaticResource Muted}" FontSize="11" LineHeight="19"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
     <DockPanel Grid.Row="1" LastChildFill="False" Margin="2,13,2,0">
      <Button x:Name="QueryButton" DockPanel.Dock="Right" Content="解释一下  →" Style="{StaticResource Primary}" Margin="0" Padding="18,11" Click="Query_Click" AutomationProperties.AutomationId="QueryButton"/>
      <TextBlock Text="Enter 查询" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
     </DockPanel>
    </Grid>
   </TabItem>
   <TabItem Header="设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,20,0,8">
      <TextBlock Text="按你的习惯设置。" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <TextBlock Text="连接 AI 服务，调整舒适的阅读大小。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,18"/>
      <Border Style="{StaticResource Sheet}">
       <StackPanel>
        <TextBlock Text="AI 连接" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <TextBlock Text="服务地址" FontSize="12" Margin="0,0,0,7"/>
        <TextBox x:Name="UrlInput" AutomationProperties.AutomationId="UrlInput"/>
        <TextBlock Text="例如 https://服务地址/v1，支持完整接口地址。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,14"/>
        <TextBlock Text="API Key" FontSize="12" Margin="0,0,0,7"/>
        <PasswordBox x:Name="KeyInput" AutomationProperties.AutomationId="KeyInput"/>
        <TextBlock Text="在本机加密保存。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,14"/>
        <TextBlock Text="模型名称" FontSize="12" Margin="0,0,0,7"/>
        <TextBox x:Name="ModelInput" AutomationProperties.AutomationId="ModelInput"/>
        <TextBlock Text="使用服务商提供的准确模型名称。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,18"/>
        <WrapPanel>
         <Button Content="保存配置" Style="{StaticResource Primary}" Click="Save_Click"/>
         <Button x:Name="TestButton" Content="测试连接" Click="Test_Click"/>
        </WrapPanel>
        <TextBlock x:Name="SettingsStatus" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource Accent}" AutomationProperties.AutomationId="SettingsStatus"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Sheet}" Margin="0,14,0,0">
       <StackPanel>
        <TextBlock Text="阅读与显示" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <DockPanel Margin="0,0,0,12">
         <TextBlock x:Name="FontScaleLabel" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontWeight="Medium" Text="100%"/>
         <TextBlock Text="字体大小" FontSize="12"/>
        </DockPanel>
        <Slider x:Name="FontScaleSlider" Minimum="0.8" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="0.2" Value="1" ValueChanged="FontScale_Changed" AutomationProperties.AutomationId="FontScaleSlider" ToolTip="80% – 200%"/>
        <Grid Margin="0,18,0,12">
         <CheckBox x:Name="FollowWindowCheck" Content="随窗口大小自动缩放" FontSize="12" Checked="FollowWindow_Changed" Unchecked="FollowWindow_Changed" AutomationProperties.AutomationId="FollowWindowCheck"/>
        </Grid>
        <TextBlock Text="拖大窗口时，文字和间距一起放大。解释卡片也可以拖动右下角调整大小。" FontSize="11" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
        <Button Content="恢复默认" HorizontalAlignment="Left" Style="{StaticResource Quiet}" Margin="-8,0,0,0" Click="ResetDisplay_Click"/>
        <TextBlock x:Name="DisplayStatus" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource Accent}"/>
       </StackPanel>
      </Border>
      <TextBlock Text="仅支持 OpenAI 兼容的 Chat Completions 接口。查询和测试连接可能产生服务商费用；测试连接会发送“随机森林”。" Foreground="{StaticResource Muted}" FontSize="11" Margin="4,14,4,0" LineHeight="20"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="历史">
    <Grid Margin="0,20,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="最近查过的，都在这里。" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="最近 100 条，仅保存在本机。点击即可回看，无需再次查询。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18"/>
      <TextBlock Text="搜索词句或上下文" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,7"/>
     </StackPanel>
     <TextBox x:Name="HistoryFilter" Grid.Row="1" TextChanged="HistoryFilter_Changed" ToolTip="按词句或上下文筛选历史" AutomationProperties.AutomationId="HistoryFilter"/>
     <DockPanel Grid.Row="2" Margin="2,9,0,10">
      <Button x:Name="ClearHistoryButton" Content="清空历史" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Foreground="#BB3434" Padding="8,5" Margin="0" Click="ClearHistory_Click"/>
      <TextBlock x:Name="HistoryCount" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
     </DockPanel>
     <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="5">
      <Grid>
       <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate>
         <Button Tag="{Binding}" Click="HistoryOpen_Click" HorizontalContentAlignment="Stretch" Background="White" Foreground="{StaticResource Ink}" Padding="12,12" Margin="0,0,0,3">
          <StackPanel>
           <TextBlock Text="{Binding Preview}" FontSize="14" FontWeight="Medium"/>
           <TextBlock Text="{Binding Caption}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
          </StackPanel>
         </Button>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="HistoryEmpty" Text="还没有查询历史。完成一次查询后会自动保存。" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="22" Margin="22,28" VerticalAlignment="Top" IsHitTestVisible="False"/>
      </Grid>
     </Border>
     <TextBlock x:Name="HistoryStatus" Grid.Row="4" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,10,0,0"/>
    </Grid>
   </TabItem>
  </TabControl>
  </Grid>
  <Grid Grid.Row="2" Margin="2,14,2,0">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Status" Text="就绪 · 点击查询时才联网" Foreground="{StaticResource Muted}" FontSize="10"/>
   <TextBlock Grid.Column="1" Text="关闭后驻留托盘" Foreground="{StaticResource Muted}" FontSize="10" Margin="10,0,0,0"/>
  </Grid>
 </Grid>
</Window>
